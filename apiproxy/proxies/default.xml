<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  apiproxy/proxies/default.xml
  ════════════════════════════════════════════════════════════════════════════════
  Proxy endpoint for gateway-db-mcp bridge.

  Policy execution order:
    PreFlow request:
      1. KVM-GetDBPassword   loads DB password → {private.db.password}
      2. VA-VerifyToken       validates OAuth 2.0 token          [add yours]
      3. SA-AgentRateLimit    per-agent rate limiting             [add yours]

    Flow (all paths):
      4. JC-DBBridge          executes DB operation, writes response

    PostFlow response:
      5. ML-OTELLog           emits structured audit log to Cloud Logging

  RouteRule = NoRoute: the callout owns the HTTP response entirely.
  No backend target endpoint is needed.
  ════════════════════════════════════════════════════════════════════════════════
-->
<ProxyEndpoint name="default">
  <Description>gateway-db-mcp Bridge Proxy</Description>

  <HTTPProxyConnection>
    <!--
      Change basepath to match your domain.
      Convention: /db-mcp/{domain-name}
      Examples:   /db-mcp/orders   /db-mcp/inventory   /db-mcp/finance
    -->
    <BasePath>/db-mcp</BasePath>
    <VirtualHost>secure</VirtualHost>
  </HTTPProxyConnection>

  <PreFlow name="PreFlow">
    <Request>
      <!-- Step 1: Load DB password from encrypted KVM. Always first. -->
      <Step><Name>KVM-GetDBPassword</Name></Step>

      <!--
        Step 2: Verify OAuth 2.0 access token.
        Uncomment and replace with your OAuthV2VerifyAccessToken policy name.
        <Step><Name>VA-VerifyToken</Name></Step>
      -->

      <!--
        Step 3: Rate limit per agent identity.
        Uncomment and replace with your SpikeArrest policy name.
        <Step><Name>SA-AgentRateLimit</Name></Step>
      -->
    </Request>
    <Response/>
  </PreFlow>

  <Flows>
    <Flow name="bridge-all-operations">
      <Request>
        <!-- Step 4: Execute DB operation — writes full response to message context -->
        <Step><Name>JC-DBBridge</Name></Step>
      </Request>
      <Response>
        <!-- Step 5: Emit OTEL structured audit log -->
        <Step><Name>ML-OTELLog</Name></Step>
      </Response>
      <Condition>proxy.pathsuffix MatchesPath "/**"</Condition>
    </Flow>
  </Flows>

  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>

  <!-- No backend target — callout handles the full response lifecycle -->
  <RouteRule name="NoRoute"/>

</ProxyEndpoint>
