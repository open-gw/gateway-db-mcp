<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  KVM-GetDBPassword.xml
  Reads the database password from an encrypted Apigee KVM into a private
  flow variable consumed by JC-DBBridge.xml as {private.db.password}.

  MUST be the first step in the proxy PreFlow request — before JC-DBBridge.

  Setup: Apigee Console → Admin → Environments → [env] → Key Value Maps
    Name: db-secrets    Encrypted: YES
    Add entry — Key: password    Value: your_db_password
-->
<KeyValueMapOperations name="KVM-GetDBPassword" mapIdentifier="db-secrets">
  <DisplayName>Get DB Password from KVM</DisplayName>
  <Scope>environment</Scope>
  <Get assignTo="private.db.password">
    <Key>
      <Parameter>password</Parameter>
    </Key>
  </Get>
</KeyValueMapOperations>
