<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.opengw</groupId>
  <artifactId>gateway-db-mcp</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>gateway-db-mcp</name>
  <description>
    Config-driven JDBC database bridge for enterprise API gateway MCP proxies.
    Supports Apigee X (embedded Java Callout), Kong Gateway, and Azure APIM.
    MySQL, PostgreSQL, and MSSQL bundled by default; MariaDB and Oracle via
    optional Maven profiles (see LICENSING.md).
  </description>
  <url>https://github.com/open-gw/gateway-db-mcp</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <organization>
    <name>open-gw</name>
    <url>https://github.com/open-gw</url>
  </organization>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <hikari.version>5.0.1</hikari.version>
    <jackson.version>2.15.2</jackson.version>
    <mysql.version>8.0.33</mysql.version>
    <mariadb.version>3.3.3</mariadb.version>
    <oracle.version>21.9.0.0</oracle.version>
    <postgres.version>42.6.0</postgres.version>
    <mssql.version>12.4.1.jre11</mssql.version>
    <h2.version>2.2.224</h2.version>
    <junit.version>5.10.0</junit.version>
    <mockito.version>5.4.0</mockito.version>
    <jmh.version>1.37</jmh.version>
    <!-- Optional MariaDB: provided (compile-only) unless -Pmariadb flips to compile. -->
    <mariadb.driver.scope>provided</mariadb.driver.scope>
    <!-- Shade excludes: no-op coordinates when the matching profile is active. -->
    <shade.exclude.mariadb>org.mariadb.jdbc:mariadb-java-client</shade.exclude.mariadb>
    <shade.exclude.mariadb.transitives>com.github.waffle:waffle-jna</shade.exclude.mariadb.transitives>
    <shade.exclude.jna>net.java.dev.jna:jna</shade.exclude.jna>
    <shade.exclude.jna.platform>net.java.dev.jna:jna-platform</shade.exclude.jna.platform>
    <shade.exclude.oracle>com.oracle.database.jdbc:ojdbc11</shade.exclude.oracle>
  </properties>

  <dependencies>

    <!-- Apigee Callout APIs: stubbed under src/main/java/com/apigee/... so the
         sidecar fat JAR is runnable with java -jar. On Apigee X, parent-first
         classloading supplies the platform implementations instead. -->

    <!-- ===== Connection Pooling ===== -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikari.version}</version>
    </dependency>

    <!-- ===== JSON ===== -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- ===== JDBC Drivers (bundled by default) ===== -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgres.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>${mssql.version}</version>
    </dependency>

    <!-- ===== Optional JDBC drivers (see profiles; LICENSING.md) ===== -->
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>${mariadb.version}</version>
      <scope>${mariadb.driver.scope}</scope>
    </dependency>

    <!-- ===== Test ===== -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- ===== JMH for validator microbenchmark ===== -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Shade: fat JAR with all deps, relocated to avoid Apigee classpath conflicts -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.opengw.dbmcp.server.SidecarServer</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <artifactSet>
                <excludes>
                  <!-- Optional drivers and MariaDB transitives; profiles clear these. -->
                  <exclude>${shade.exclude.mariadb}</exclude>
                  <exclude>${shade.exclude.mariadb.transitives}</exclude>
                  <exclude>${shade.exclude.jna}</exclude>
                  <exclude>${shade.exclude.jna.platform}</exclude>
                  <exclude>${shade.exclude.oracle}</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>com.zaxxer.hikari</pattern>
                  <shadedPattern>io.github.opengw.dbmcp.shaded.hikari</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>io.github.opengw.dbmcp.shaded.jackson</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Auto-copy shaded JAR into apiproxy/resources/java/ after build -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.basedir}/apiproxy/resources/java"/>
                <copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                      todir="${project.basedir}/apiproxy/resources/java"
                      overwrite="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>11</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <!-- LGPL-2.1 MariaDB Connector/J — optional; see LICENSING.md -->
    <profile>
      <id>mariadb</id>
      <properties>
        <mariadb.driver.scope>compile</mariadb.driver.scope>
        <!-- Coordinates that match nothing — clears the default shade excludes. -->
        <shade.exclude.mariadb>__optional__:__not-excluded__</shade.exclude.mariadb>
        <shade.exclude.mariadb.transitives>__optional__:__not-excluded__</shade.exclude.mariadb.transitives>
        <shade.exclude.jna>__optional__:__not-excluded__</shade.exclude.jna>
        <shade.exclude.jna.platform>__optional__:__not-excluded__</shade.exclude.jna.platform>
      </properties>
    </profile>

    <!-- Oracle JDBC — operator-supplied / OTN terms; declared only in-profile so
         the default build does not resolve ojdbc11. -->
    <profile>
      <id>oracle</id>
      <properties>
        <shade.exclude.oracle>__optional__:__not-excluded__</shade.exclude.oracle>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.oracle.database.jdbc</groupId>
          <artifactId>ojdbc11</artifactId>
          <version>${oracle.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
