<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  KVM-GetDBPassword.xml
  ═══════════════════════════════════════════════════════════════════════════════
  Reads the database password from an encrypted Apigee KVM into a private
  flow variable, which JC-DBBridge.xml then consumes as {private.db.password}.

  This policy MUST run BEFORE JC-DBBridge in the proxy PreFlow request.
  The private. prefix ensures the value is never logged or surfaced in traces.

  SETUP:
  ───────────────────────────────────────────────────────────────────────────────
  1. Apigee Console → Admin → Environments → [your env] → Key Value Maps
  2. Click "+ New"
     Name:      db-secrets
     Encrypted: YES (required — never store DB passwords unencrypted)
  3. Click "+ Add Entry"
     Key:   password
     Value: your_readonly_database_password

  To use separate passwords per domain (recommended for production):
  Create one KVM per domain: db-secrets-orders, db-secrets-inventory, etc.
  Update mapIdentifier below to match.
  ═══════════════════════════════════════════════════════════════════════════════
-->
<KeyValueMapOperations name="KVM-GetDBPassword" mapIdentifier="db-secrets">
  <DisplayName>Get DB Password from KVM</DisplayName>
  <Scope>environment</Scope>
  <Get assignTo="private.db.password">
    <Key>
      <Parameter>password</Parameter>
    </Key>
  </Get>
</KeyValueMapOperations>
