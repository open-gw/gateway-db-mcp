<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  KVM-GetDBPassword.xml
  ═══════════════════════════════════════════════════════════════════════════════
  Reads the database password from an encrypted Apigee KVM.
  This policy MUST run BEFORE JC-DBBridge in the proxy PreFlow request.

  SETUP:
  ───────────────────────────────────────────────────────────────────────────────
  Apigee Console → Admin → Environments → [env] → Key Value Maps → + New
    Name:      db-secrets
    Encrypted: YES

  Add entry:
    Key:   password
    Value: your_readonly_database_password

  For schema-isolated multi-tenant deployments, use separate KVMs:
    db-secrets-orders, db-secrets-reporting, db-secrets-analytics
  Update mapIdentifier below to match the domain-specific KVM.
  ═══════════════════════════════════════════════════════════════════════════════
-->
<KeyValueMapOperations name="KVM-GetDBPassword" mapIdentifier="db-secrets">
  <DisplayName>Get DB Password from KVM</DisplayName>
  <Scope>environment</Scope>
  <Get assignTo="private.db.password">
    <Key>
      <Parameter>password</Parameter>
    </Key>
  </Get>
</KeyValueMapOperations>
